# GeoLens AI — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER commit real credentials.

# ---------------------------------------------------------------------------
# LLM Planner — OpenRouter (replaces Mistral)
# ---------------------------------------------------------------------------
# Required for live LLM plan generation. Without this key, the deterministic
# rule-based fallback planner is used automatically.
#
# Get a key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
#
# Model to use. Default: google/gemini-2.0-flash-001 (paid, ~$0.10/1M input tokens).
# Free alternative (rate-limited, for dev/testing only):
#   OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Other compatible options:
#   OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
#
# Optional: override the API base URL (leave unset for production)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Optional: request timeout in seconds (default: 30)
# OPENROUTER_TIMEOUT_S=30
#
# Optional: max retries for transient 5xx/429 errors (default: 2)
# OPENROUTER_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Live integration test gate (opt-in only — never run in CI without a key)
# ---------------------------------------------------------------------------
# OPENROUTER_RUN_LIVE_TESTS=true

# ---------------------------------------------------------------------------
# Sarvam AI translation
# ---------------------------------------------------------------------------
# Required for non-English query translation. Passthrough used when absent.
# NOTE: endpoint is unverified — see translate.py TODO before activating.
# SARVAM_API_KEY=...

# ---------------------------------------------------------------------------
# Jev AI ranking
# ---------------------------------------------------------------------------
# Required for real Jev AI ranking. Local scorer used when absent.
# Stub only — see jev_ranker.py JevClient TODO.
# JEV_API_KEY=...
# JEV_API_ENDPOINT=https://api.jev.ai/v1/rank

# ---------------------------------------------------------------------------
# SkyCLIP weights
# ---------------------------------------------------------------------------
# Set to the .pt file extracted from the downloaded SkyCLIP zip.
# Run: python scripts/download_datasets.py
# Then point this to the extracted file, e.g.:
# SKYCLIP_WEIGHTS=data/embeddings/SkyCLIP_ViT_B32_top50pct/SkyCLIP_ViT_B32_top50pct.pt
#
# Architecture is inferred from the filename. Override with:
# SKYCLIP_ARCH=ViT-B/32   (default, CPU-feasible)
# SKYCLIP_ARCH=ViT-L/14   (requires GPU for indexing)
SKYCLIP_WEIGHTS=data/embeddings/skyclip_weights.pt
# SKYCLIP_ARCH=ViT-B/32

# ---------------------------------------------------------------------------
# Feature flags (PROPOSED — off by default)
# ---------------------------------------------------------------------------
# FEATURE_NEGATE=false
# FEATURE_MIN_AREA=false

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Set to true to serve data/fixtures/demo_results.json instead of the pipeline.
# Shows "Sample data" banner in UI.
# DEMO_MODE=false

# ---------------------------------------------------------------------------
# Detection cache
# ---------------------------------------------------------------------------
# FEATURE_DETECTION_CACHE=false
